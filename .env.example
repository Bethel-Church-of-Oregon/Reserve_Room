# Neon / Postgres — Vercel Marketplace 연동 시 자동 주입
# POSTGRES_URL 또는 DATABASE_URL 사용
POSTGRES_URL=postgres://user:password@host/database?sslmode=require

# 관리자 비밀번호
ADMIN_PASSWORD=

# Gmail 앱 비밀번호 (이메일 알림, 선택)
GMAIL_APP_PASSWORD=

# Twilio (문자 알림). 셋 다 설정해야 문자가 발송되며, 미설정 시 문자만 건너뛰고 예약은 정상 동작
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=          # Twilio에서 구매한 번호, E.164 형식 (예: +15035551234)

# 월 1회 자동 백업 크론 (vercel.json). 임의의 긴 문자열이면 됨 — 예: openssl rand -hex 32
# 미설정 시 /api/cron/backup 은 503 으로 비활성 (열린 채로 두지 않기 위함)
CRON_SECRET=

# Upstash Redis (rate limiting). 미설정 시 rate limiting이 **전부 비활성** —
# 예약 스팸과 관리자 비밀번호 무차별 대입에 제동장치가 없어지므로 프로덕션에는 반드시 설정
# console.upstash.com → Create database → Redis → 상세 페이지 "REST API" 섹션에서 복사
UPSTASH_REDIS_REST_URL=      # 예: https://apn1-xxxx-yyyy-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=    # 같은 화면의 REST TOKEN (긴 문자열)

# 텔레그램 알림 (담당자 그룹). 둘 다 설정해야 발송되며, 미설정 시 텔레그램만 건너뜀
TELEGRAM_BOT_TOKEN=          # @BotFather 에서 발급 (예: 8123456789:AAH...)
TELEGRAM_CHAT_ID=            # 담당자 그룹의 chat_id (그룹은 보통 -100 으로 시작하는 음수)
