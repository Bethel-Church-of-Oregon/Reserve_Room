# Neon / Postgres — Vercel Marketplace 연동 시 자동 주입
# POSTGRES_URL 또는 DATABASE_URL 사용
POSTGRES_URL=postgres://user:password@host/database?sslmode=require

# 관리자 비밀번호
ADMIN_PASSWORD=

# Gmail 앱 비밀번호 (이메일 알림, 선택)
GMAIL_APP_PASSWORD=

# Twilio (문자 알림). 셋 다 설정해야 문자가 발송되며, 미설정 시 문자만 건너뛰고 예약은 정상 동작
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=          # Twilio에서 구매한 번호, E.164 형식 (예: +15035551234)

# 텔레그램 알림 (담당자 그룹). 둘 다 설정해야 발송되며, 미설정 시 텔레그램만 건너뜀
TELEGRAM_BOT_TOKEN=          # @BotFather 에서 발급 (예: 8123456789:AAH...)
TELEGRAM_CHAT_ID=            # 담당자 그룹의 chat_id (그룹은 보통 -100 으로 시작하는 음수)
